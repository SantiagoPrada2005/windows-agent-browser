# Variables de configuración para Asistente Guiador de Ofimática

# Nombre y entorno
APP_NAME="Asistente Guiador de Ofimática"
APP_VERSION="0.1.0"
DEBUG=false

# Proveedor LLM rápido (Groq u endpoint compatible)
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"

# Proveedor de Visión (OpenRouter / DeepSeek directo)
OPENROUTER_API_KEY=""
VISION_MODEL="deepseek/deepseek-chat"

# Parámetros de detección de cambios de pantalla (OpenCV local)
SCREEN_CHANGE_THRESHOLD=0.03
SCREEN_CHECK_WIDTH=640
SCREEN_CHECK_HEIGHT=360

# Audio y Wake word
WAKE_WORD="hey asistente"
STT_LANGUAGE="es"
